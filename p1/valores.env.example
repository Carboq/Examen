# Valores para generar las configuraciones de la P1.
# Copiar a valores.env y ajustar con el esquema del enunciado.
# Formato: CLAVE=valor (sin espacios alrededor del =).

# --- Segmentos LAN ---------------------------------------------------
LAN1_ID=1
LAN1_IP=192.168.1.1
LAN1_NET=192.168.1.0
LAN1_MASK=255.255.255.0

LAN2_ID=2
LAN2_IP=192.168.2.1
LAN2_NET=192.168.2.0
LAN2_MASK=255.255.255.0

LAN3_ID=3
LAN3_IP=192.168.3.1
LAN3_NET=192.168.3.0
LAN3_MASK=255.255.255.0

LAN4_ID=4
LAN4_IP=192.168.4.1
LAN4_NET=192.168.4.0
LAN4_MASK=255.255.255.0

LAN5_ID=5
LAN5_IP=192.168.5.1
LAN5_NET=192.168.5.0
LAN5_MASK=255.255.255.0

# --- Enlaces entre routers (/30) -------------------------------------
L12_R1=10.0.12.1
L12_R2=10.0.12.2
L12_NET=10.0.12.0

L23_R2=10.0.23.1
L23_R3=10.0.23.2
L23_NET=10.0.23.0

L34_R3=10.0.34.1
L34_R4=10.0.34.2
L34_NET=10.0.34.0

# --- Servidor DHCP/DNS -----------------------------------------------
SRV_IP=192.168.1.5
DOMINIO=empresa.local
