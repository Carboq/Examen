# Configuración del entorno de examen.
# Copiar a config.env y ajustar. config.env no se sube al repositorio.

# --- Práctica 2 y 3 -------------------------------------------------
# Matriz por defecto de la P2: 3 activos + 1 de repuesto.
MD=/dev/md0
LEVEL=5
ACTIVE=3
SPARES=1
FS=ext4
MNT=/mnt/raid5

# Discos, separados por comas. Vacío = detectarlos con `./icd.sh p2 detect`.
# Ejemplo: DISKS=sdb,sdc,sdd,sde
DISKS=

# --- Práctica 4 -----------------------------------------------------
# Almacenamiento de Proxmox donde se crean los discos de las VM.
STORAGE=local-lvm
# Bridge al que se conectan las VM de la P4.
BRIDGE=vmbr1
# ISO de Debian (volid de Proxmox). Vacío = no se adjunta.
ISO=local:iso/debian-12-netinst.iso

# --- Práctica 5 -----------------------------------------------------
P5_VMID=250
P5_NAME=pfsense
P5_MEM=2048
P5_CORES=2
P5_DISK=16
P5_WAN_BRIDGE=vmbr0
P5_LAN_BRIDGE=vmbr1
P5_DMZ_BRIDGE=vmbr2
P5_ISO=local:iso/pfSense-CE-2.7.2-RELEASE-amd64.iso
# MAC reservada del laboratorio. Se calcula con:
#   ./icd.sh p5 mac <MAC de la primera VM> <numero de PC>
P5_MAC=

# --- Comportamiento -------------------------------------------------
# 1 = no pedir confirmación (útil en el examen, peligroso en casa).
ASSUME_YES=0
